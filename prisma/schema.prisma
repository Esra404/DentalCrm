generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentPlanStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(160)
  email     String     @unique @db.VarChar(320)
  passwordHash String?  @db.VarChar(255)
  role      Role       @default(STAFF)
  isActive  Boolean    @default(true)
  doctor    Doctor?
  patient   Patient?
  auditLogs AuditLog[]
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
}

model Patient {
  id             String            @id @default(uuid()) @db.Uuid
  firstName      String            @db.VarChar(100)
  lastName       String            @db.VarChar(100)
  email          String?           @db.VarChar(320)
  phone          String?           @db.VarChar(32)
  dateOfBirth    DateTime?         @db.Date
  address        String?           @db.Text
  notes          String?           @db.Text
  isActive       Boolean           @default(true)
  userId         String?           @unique @db.Uuid
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]
  documents      PatientDocument[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
}

model Doctor {
  id             String          @id @default(uuid()) @db.Uuid
  firstName      String          @db.VarChar(100)
  lastName       String          @db.VarChar(100)
  email          String?         @db.VarChar(320)
  phone          String?         @db.VarChar(32)
  specialty      String?         @db.VarChar(120)
  licenseNumber  String?         @unique @db.VarChar(64)
  isActive       Boolean         @default(true)
  userId         String?         @unique @db.Uuid
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([lastName, firstName])
}

model Treatment {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @unique @db.VarChar(160)
  description  String?             @db.Text
  defaultPrice Decimal             @db.Decimal(12, 2)
  currency     String              @default("TRY") @db.Char(3)
  isActive     Boolean             @default(true)
  planItems    TreatmentPlanItem[]
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
}

model TreatmentPlan {
  id                String              @id @default(uuid()) @db.Uuid
  patientId         String              @db.Uuid
  createdByDoctorId String?             @db.Uuid
  status            TreatmentPlanStatus @default(DRAFT)
  currency          String              @default("TRY") @db.Char(3)
  notes             String?             @db.Text
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByDoctor   Doctor?             @relation(fields: [createdByDoctorId], references: [id], onDelete: Restrict)
  items             TreatmentPlanItem[]
  payments          Payment[]
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([patientId, createdAt])
  @@index([createdByDoctorId, createdAt])
  @@index([status, createdAt])
}

model TreatmentPlanItem {
  id              String        @id @default(uuid()) @db.Uuid
  treatmentPlanId String        @db.Uuid
  treatmentId     String        @db.Uuid
  treatmentName   String        @db.VarChar(160)
  quantity        Int           @default(1)
  unitPrice       Decimal       @db.Decimal(12, 2)
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  treatment       Treatment     @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([treatmentPlanId])
  @@index([treatmentId])
}

model Appointment {
  id        String            @id @default(uuid()) @db.Uuid
  patientId String            @db.Uuid
  doctorId  String            @db.Uuid
  startsAt  DateTime          @db.Timestamptz(3)
  endsAt    DateTime          @db.Timestamptz(3)
  status    AppointmentStatus @default(SCHEDULED)
  note      String?           @db.Text
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  treatmentPlanId String        @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  paidAt          DateTime      @default(now()) @db.Timestamptz(3)
  reference       String?       @db.VarChar(160)
  note            String?       @db.Text
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([treatmentPlanId, paidAt])
}

model PatientDocument {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  storageProvider String   @db.VarChar(32)
  storageKey      String   @unique @db.VarChar(512)
  fileName        String   @db.VarChar(255)
  mimeType        String   @db.VarChar(127)
  sizeBytes       BigInt
  uploadedAt      DateTime @default(now()) @db.Timestamptz(3)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, uploadedAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(120)
  entity    String?  @db.VarChar(120)
  entityId  String?  @db.VarChar(128)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
